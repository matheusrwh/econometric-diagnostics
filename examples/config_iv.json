{
  "title": "Synthetic IV example",
  "data": "iv_example.csv",
  "cluster": "state",
  "output_dir": "output_iv",
  "models": {
    "two_instruments": {
      "formula": "y ~ 1 + w + [x ~ z1 + z2]",
      "key": ["x"],
      "label": "2SLS, z1 and z2"
